&i2c0 {
    status = "okay";
    clock-frequency = <I2C_BITRATE_STANDARD>;
    zephyr,concat-buf-size = <1040>;
    zephyr,flash-buf-max-size = <1040>;

    ssd1306: ssd1306@3c {
        compatible = "solomon,ssd1306";
        reg = <0x3c>;
        width = <128>;
        height = <64>;

        segment-offset = <0>;
        page-offset = <0>;
        display-offset = <0>;
        multiplex-ratio = <63>;
        segment-remap;
        com-invdir;
        prechargep = <0x22>;
    };
    	myaccel: myaccel@18 {
        compatible = "st,lis2dh-common";
        reg = <0x18>;
    };
};

/ {
    chosen {
        zephyr_display = &ssd1306;  // 这里是下划线 _，不是逗号 ,
    };
};
